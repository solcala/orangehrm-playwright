# Copy to .env (git-ignored): cp .env.example .env

# --- App under test (read by playwright.config.ts and fixtures/test-data.ts) ---
BASE_URL=https://opensource-demo.orangehrmlive.com
ORANGEHRM_USERNAME=Admin
ORANGEHRM_PASSWORD=admin123

# --- Test data (read by the `faker` fixture in fixtures/pages.ts) ---
# Optional. Unset = a random seed per test. To replay a failed test's data, set it to the
# "faker-seed" annotation shown for that test in the HTML report (a non-negative integer).
# FAKER_SEED=123456

# --- MCP servers (.mcp.json) ---
# Claude Code expands ${VAR} in .mcp.json from the shell it was launched from,
# NOT from .env — export these in your shell profile (~/.zshrc).

# GitHub MCP: create a token at https://github.com/settings/tokens
# with scopes: repo, workflow, read:org
GITHUB_PERSONAL_ACCESS_TOKEN=

# Optional: Context7 API key for higher rate limits (free tier works without it).
# If set, add an Authorization header to the "context7" entry in .mcp.json.
# CONTEXT7_API_KEY=
